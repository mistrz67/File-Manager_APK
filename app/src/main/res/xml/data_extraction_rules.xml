<?xml version="1.0" encoding="utf-8"?>
<!-- See backup_rules.xml: encrypted network drive secrets are never backed up or transferred. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="network_drive_secrets.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="network_drive_secrets.xml" />
    </device-transfer>
</data-extraction-rules>
